{
  "name": "@shopping-copilot/api",
  "version": "1.0.0",
  "private": true,
  "description": "NestJS backend: product retrieval, conversation persistence and the shopping agent",
  "scripts": {
    "dev": "nest start --watch",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "eval": "ts-node --project tsconfig.json eval/run-eval.ts",
    "simulate": "ts-node --project tsconfig.json eval/simulation/run-simulation.ts"
  },
  "dependencies": {
    "@mastra/core": "^1.52.1",
    "@mastra/observability": "^1.16.2",
    "@nestjs/common": "^11.0.10",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.10",
    "@nestjs/platform-express": "^11.0.10",
    "@shopping-copilot/shared": "*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "openai": "^4.85.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.4",
    "@nestjs/schematics": "^11.0.1",
    "@nestjs/testing": "^11.0.10",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
