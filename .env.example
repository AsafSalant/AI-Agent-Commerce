# Copy to .env and fill in. The API reads this file on startup.
OPENAI_API_KEY=sk-...

# Model used for the conversational agent (tool calling).
OPENAI_MODEL=gpt-5.4-mini
# Cheaper model used for background chores such as conversation titles.
OPENAI_TITLE_MODEL=gpt-5.4-nano
# Model behind the prompt-injection guardrail: one small call per shopper turn.
OPENAI_GUARD_MODEL=gpt-5.4-nano
# Set to `off` to skip that call. Normalisation and the data blocks still apply.
# AGENT_GUARDRAILS=off

# Multi-turn simulation harness (npm run simulate). Both default to OPENAI_MODEL.
# Model that role-plays the shopper.
SIMULATION_USER_MODEL=gpt-5.4-mini
# Model that scores finished conversations against a scenario rubric.
SIMULATION_JUDGE_MODEL=gpt-5.4-mini

# API server
PORT=3001
CORS_ORIGIN=http://localhost:5173

# Product catalog
DUMMYJSON_BASE_URL=https://dummyjson.com

# Where conversations are persisted (JSON file store, relative to apps/api)
DATA_DIR=./data
# Set to `memory` for ephemeral runs that leave no conversation history on disk.
# PERSISTENCE=memory

# Mastra Platform observability — traces and metrics in the dashboard.
# Both must be set to enable; leave unset to run without observability.
MASTRA_PLATFORM_ACCESS_TOKEN=sk_...
MASTRA_PROJECT_ID=...
